<Project Sdk="Microsoft.NET.Sdk">

  <!-- Leak soak for a MODULE-OWNED WINDOW, which runtime-resource-soak.ps1 structurally cannot reach: that
       harness samples the shipped app from outside, and the app's churn loop (Program.RuntimeResourceChurn)
       only drives pets/speech and the tray, never a WPF window a module owns. The host also keeps no
       compile-time reference to any module.

       So this is a separate console exe that loads a module's built DLL at RUNTIME and drives its window by
       reflection. There is deliberately no reference to PetStudio.dll: PetStudioWindow is `internal sealed`,
       so a compile-time reference would buy nothing, and leaving it out keeps this project free of any
       build-order coupling to the module output.

       UseWPF (not UseWindowsForms like CoreTests) because the window under test is WPF, which is also why
       this cannot simply live inside DesktopAICompanion.CoreTests. Console (OutputType Exe) so the exit code is the
       result, matching every other harness here.
       (Note: a double hyphen is illegal inside an XML comment and fails the build with MSB4025.) -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\ProductVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DesktopAICompanion.WindowSoak</RootNamespace>
    <AssemblyName>DesktopAICompanion.WindowSoak</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep the flat bin\<Config> layout the soak script and the release checklist expect. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\</OutputPath>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release\</OutputPath>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- Contracts for IHost, ModuleKit for RecordingHost: the module's window takes an IHost, and ModuleKit
       already ships the fake rather than this harness hand-rolling one that rots on every ABI addition.
       Both are referenced normally (private) so they land in this harness's own output folder; the module
       DLL loaded at runtime unifies against them by assembly identity. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopAICompanion.Contracts\DesktopAICompanion.Contracts.csproj" />
    <ProjectReference Include="..\..\src\DesktopAICompanion.ModuleKit\DesktopAICompanion.ModuleKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>