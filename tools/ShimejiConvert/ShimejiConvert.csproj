<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline Shimeji -> animations.xml converter (BACKLOG #4), built as a console tool rather than a
       module: the stated workflow is "convert -> hand-check -> commit to our Pets/ mirror", which is a dev
       workflow, not an end-user feature. The conversion ENGINE lives in ShimejiConvert.Engine so the
       Shimeji Importer module (modules/ShimejiImporter) can share it unchanged. This project is just the
       CLI: argument parsing, directory enumeration, and console formatting. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\ProductVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopAICompanion.Tools.ShimejiConvert</RootNamespace>
    <AssemblyName>ShimejiConvert</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- No WarningLevel here, on purpose (N-bd-w6-tests-core-1-02): the SDK's default for this net10 target is 10,
         which keeps the compiler's warning waves 5 to 10 on under TreatWarningsAsErrors. The engine's project
         says the same; tests\runtime-hardening-selftest.ps1 fails on a pin below the default in either. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\</OutputPath>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release\</OutputPath>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <!-- Embedded symbols with the repository root mapped to /_/ and no Source Link record, for the reasons the
         engine's project gives (N-bd-closure2-02): this dll is the other half of the converterSha256 witness, a
         separate pdbonly PDB put the absolute build folder in its CodeView record, and the SDK's default Source Link
         record names that folder and the commit. The selftest fails on any Source Link record in either dll, whatever
         its keys (N-bd-w12-review-04). Debug keeps its full separate PDB. -->
    <DebugType>embedded</DebugType>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))=/_/</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShimejiConvert.Engine\ShimejiConvert.Engine.csproj" />
  </ItemGroup>

</Project>
