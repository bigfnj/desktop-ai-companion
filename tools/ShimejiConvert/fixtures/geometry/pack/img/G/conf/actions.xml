<?xml version="1.0" encoding="utf-8"?>
<Mascot xmlns="http://www.group-finity.com/Mascot">
  <ActionList>
    <Action Name="Stand" Type="Stay" Duration="250">
      <Animation>
        <Pose Image="/p.png" ImageAnchor="2,6" Velocity="0,0" Duration="2"/>
        <Pose Image="/q.png" ImageAnchor="-2,9" Velocity="0,0" Duration="2"/>
        <Pose Image="/p.png" ImageRight="/r.png" ImageAnchor="1,5" Velocity="0,0" Duration="2"/>
        <Pose Image="/q.png" ImageAnchor="5,4" Velocity="0,0" Duration="2"/>
      </Animation>
    </Action>
    <Action Name="Fall" Type="Embedded" Class="com.group_finity.mascot.action.Fall">
      <Animation><Pose Image="/p.png" ImageAnchor="2,6" Velocity="0,0" Duration="250"/></Animation>
    </Action>
    <Action Name="Dragged" Type="Embedded" Class="com.group_finity.mascot.action.Dragged">
      <Animation><Pose Image="/p.png" ImageAnchor="2,6" Velocity="0,0" Duration="250"/></Animation>
    </Action>
  </ActionList>
</Mascot>
