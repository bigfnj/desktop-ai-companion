<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>AgentBroker.Worker</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentBroker.Adapter.Tests" />
    <InternalsVisibleTo Include="AgentBroker.Network.Tests" />
    <ProjectReference Include="../../src/AgentBroker.Core/AgentBroker.Core.csproj" />
    <ProjectReference Include="../AgentBroker.CodexDesktopAdapter/AgentBroker.CodexDesktopAdapter.csproj" />
    <ProjectReference Include="../AgentBroker.ClaudeAdapter/AgentBroker.ClaudeAdapter.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WinVerifyTrust mechanics the Claude public-image check shares with the Codex adapter's publisher check
         (N-broker-b-02), compiled here as linked source; the adapter's own copy is internal to it. -->
    <Compile Include="..\AgentBroker.Pins\WindowsAuthenticode.cs" Link="Pins\WindowsAuthenticode.cs" />
  </ItemGroup>
</Project>
