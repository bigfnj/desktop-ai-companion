<Project Sdk="Microsoft.NET.Sdk">

  <!-- ShimejiConvert conversion engine. Shared by the ShimejiConvert CLI (tools/ShimejiConvert) and Pet
       Studio (modules/PetStudio, which source-links these files), so the conversion rules live in one place.

       It recompiles three production sources (AnimationXML, CompanionXmlValidator, SafeExpression) instead of
       referencing the app (the app is a WinExe and CompanionXmlValidator is internal). That is the same trick
       tests\DesktopAICompanion.CoreTests uses, and it is load-bearing: the converter MUST be graded by the app's
       real validator, not by a second copy of the rules that can drift. net10.0-windows + UseWindowsForms so
       those shared sources compile in the same environment as the app (System.Drawing / SafeHandles in
       CompanionXmlValidator). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\ProductVersion.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF is pulled in ONLY for its Windows Imaging Component wrapper (System.Windows.Media.Imaging.
         BitmapDecoder in WebPLoader.cs): GDI+ cannot decode the Android-Shimeji bundle's WebP sprites, and
         WIC can, in-process, with no native/NuGet dependency. No XAML is compiled. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>DesktopAICompanion.Tools.ShimejiConvert</RootNamespace>
    <AssemblyName>ShimejiConvert.Engine</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\</OutputPath>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release\</OutputPath>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Engine.cs" />
    <Compile Include="PetGraph.cs" />
    <Compile Include="ValidatorResources.cs" />
    <Compile Include="Shimeji\ShimejiModel.cs" />
    <Compile Include="Shimeji\ShimejiParser.cs" />
    <Compile Include="Shimeji\ActionClassifier.cs" />
    <Compile Include="Shimeji\SkinLayout.cs" />
    <Compile Include="Shimeji\SpriteSheetBuilder.cs" />
    <Compile Include="Shimeji\WebPLoader.cs" />
    <Compile Include="Shimeji\BundleParser.cs" />
    <Compile Include="Shimeji\BundleConverter.cs" />
    <Compile Include="Emit\IconBuilder.cs" />
    <Compile Include="Emit\ResidueReport.cs" />
    <Compile Include="Emit\PetEmitter.cs" />
    <Compile Include="Shimeji\ClassifierSelfTest.cs" />
    <Compile Include="Shimeji\CompositorSelfTest.cs" />
    <Compile Include="Shimeji\EmitterSelfTest.cs" />
    <Compile Include="Shimeji\BundledConfSelfTest.cs" />
    <Compile Include="Shimeji\BundleSelfTest.cs" />
    <Compile Include="Shimeji\VocabSelfTest.cs" />
    <Compile Include="Shimeji\SoundResolveSelfTest.cs" />
    <Compile Include="Shimeji\HubWeightSelfTest.cs" />
    <Compile Include="Shimeji\PetGraphSelfTest.cs" />
    <Compile Include="Shimeji\LayoutSelfTest.cs" />
    <Compile Include="Shimeji\EngineSelfTest.cs" />
  </ItemGroup>

  <!-- Production sources, recompiled. Do not edit these to suit the engine; the point is that the engine is
       graded by exactly what the app enforces. -->
  <ItemGroup>
    <Compile Include="..\..\src\LocalData\AnimationXML.cs">
      <Link>Shared\AnimationXML.cs</Link>
    </Compile>
    <Compile Include="..\..\src\dotNet\CompanionXmlValidator.cs">
      <Link>Shared\CompanionXmlValidator.cs</Link>
    </Compile>
    <Compile Include="..\..\src\dotNet\SafeExpression.cs">
      <Link>Shared\SafeExpression.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- CompanionXmlValidator reads the schema from Properties.Resources.animations1, a generated ResX accessor
       that exists only in the app. Embedding the same XSD file and shimming that one accessor
       (ValidatorResources.cs) keeps the validator source byte-identical to the app's. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Resources\animations.xsd">
      <LogicalName>ShimejiConvert.animations.xsd</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The Shimeji-EE base behaviour config (BSD-licensed, see base-conf/NOTICE.txt), bundled so a
       sprites-only skin with no conf of its own can still convert. Only these behaviour XMLs ship; never
       sprite art. -->
  <ItemGroup>
    <EmbeddedResource Include="base-conf\actions.xml">
      <LogicalName>base-actions.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="base-conf\behaviors.xml">
      <LogicalName>base-behaviors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Bundled WebP decoder (libwebp's dwebp.exe, BSD-3, see native\NOTICE-libwebp.txt). WebPLoader shells out
       to this because WIC drops WebP alpha on some machines. Copied to output\native\ for the CLI (and any
       consumer that ProjectReferences the engine); a source-linking consumer must copy it itself. -->
  <ItemGroup>
    <None Include="native\dwebp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="native\NOTICE-libwebp.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Source-text invariant: the SpriteFrameStore.MaximumFrames shim in ValidatorResources.cs mirrors a
       constant in src/dotNet/Xml.cs that this project deliberately does not compile, and PetGraph's
       ReservedEntryPointNames mirror the loader's animation-name switch. Catch drift at build time rather
       than shipping a converter that accepts more sprite tiles, or names the wrong entry points, than the
       app will honour. -->
  <Target Name="AssertSpriteFrameLimit" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_XmlCsPath>$(MSBuildThisFileDirectory)..\..\src\dotNet\Xml.cs</_XmlCsPath>
    </PropertyGroup>
    <!-- BEFORE the read. A target runs its children in order, and ReadAllText on a missing path throws MSB4184
         first, so this message was unreachable while it sat below the PropertyGroup that read the file (F461). -->
    <Error Condition="!Exists('$(_XmlCsPath)')"
           Text="Cannot verify the SpriteFrameStore shim: $(_XmlCsPath) is missing." />
    <PropertyGroup>
      <_XmlCsText>$([System.IO.File]::ReadAllText('$(_XmlCsPath)'))</_XmlCsText>
    </PropertyGroup>
    <Error Condition="!$(_XmlCsText.Contains('case &quot;fall&quot;: animations.AnimationFall'))"
           Text="src/dotNet/Xml.cs no longer binds the &apos;fall&apos; animation name as a runtime entry point. PetGraph.ReservedEntryPointNames must match the loader or reachability reports go wrong." />
    <Error Condition="!$(_XmlCsText.Contains('case &quot;drag&quot;: animations.AnimationDrag'))"
           Text="src/dotNet/Xml.cs no longer binds the &apos;drag&apos; animation name as a runtime entry point. PetGraph.ReservedEntryPointNames must match the loader or reachability reports go wrong." />
    <Error Condition="!$(_XmlCsText.Contains('case &quot;kill&quot;: animations.AnimationKill'))"
           Text="src/dotNet/Xml.cs no longer binds the &apos;kill&apos; animation name as a runtime entry point. PetGraph.ReservedEntryPointNames must match the loader or reachability reports go wrong." />
    <Error Condition="!$(_XmlCsText.Contains('case &quot;sync&quot;: animations.AnimationSync'))"
           Text="src/dotNet/Xml.cs no longer binds the &apos;sync&apos; animation name as a runtime entry point. PetGraph.ReservedEntryPointNames must match the loader or reachability reports go wrong." />
    <Error Condition="!$(_XmlCsText.Contains('MaximumFrames = 1024'))"
           Text="SpriteFrameStore.MaximumFrames no longer reads 1024 in src/dotNet/Xml.cs. Update the shim in tools/ShimejiConvert.Engine/ValidatorResources.cs to match, then re-run." />
    <!-- The SHIM too. This target read only Xml.cs, so the file it is described as protecting could drift
         on its own and the engine's validator would grade a foreign pet against a tile cap the app refuses
         (F462). Exists first, so a moved file is a named error rather than a Contains() over an empty string. -->
    <PropertyGroup>
      <_ShimCsPath>$(MSBuildThisFileDirectory)ValidatorResources.cs</_ShimCsPath>
      <_ShimCsText Condition="Exists('$(_ShimCsPath)')">$([System.IO.File]::ReadAllText('$(_ShimCsPath)'))</_ShimCsText>
    </PropertyGroup>
    <Error Condition="!Exists('$(_ShimCsPath)')"
           Text="Cannot verify the SpriteFrameStore shim: $(_ShimCsPath) is missing." />
    <Error Condition="Exists('$(_ShimCsPath)') and !$(_ShimCsText.Contains('MaximumFrames = 1024'))"
           Text="The SpriteFrameStore shim in tools/ShimejiConvert.Engine/ValidatorResources.cs no longer reads 1024 while src/dotNet/Xml.cs does. The shim must match the app; change it back, or change both deliberately." />
    <!-- The RUNTIME's fallback rules too (R-070). PetGraph.RuntimeFallbackFor restates Animations.ResolveMagicAnimation
         (an exact binding is kept; else ascending id order, the first name CONTAINING the word ignoring case; else the
         lowest id) and ResolveMagicAnimations' choice of drag and fall ONLY, which this project does not compile. A host
         that changed any of those (a StartsWith, a kill or sync fallback, a different default) built the engine
         clean and PetGraphSelfTest still passed, because the self-test pins the mirror against the mirror. Each
         assertion names the CONDITION or the ORDER the mirror depends on, never the method's existence, and the last
         two assert the ABSENCE of the resolutions the mirror says the host does not make. Exists first, as above. -->
    <PropertyGroup>
      <_AnimationsCsPath>$(MSBuildThisFileDirectory)..\..\src\dotNet\Animations.cs</_AnimationsCsPath>
      <_AnimationsCsText Condition="Exists('$(_AnimationsCsPath)')">$([System.IO.File]::ReadAllText('$(_AnimationsCsPath)'))</_AnimationsCsText>
    </PropertyGroup>
    <Error Condition="!Exists('$(_AnimationsCsPath)')"
           Text="Cannot verify PetGraph's fallback mirror: $(_AnimationsCsPath) is missing." />
    <Error Condition="Exists('$(_AnimationsCsPath)') and !$(_AnimationsCsText.Contains('AnimationDrag = ResolveMagicAnimation(AnimationDrag, &quot;drag&quot;, lowest);'))"
           Text="src/dotNet/Animations.cs no longer resolves the drag animation by fallback the way PetGraph.RuntimeFallbackFor mirrors it. Update PetGraph and PetGraphSelfTest with the host, deliberately." />
    <Error Condition="Exists('$(_AnimationsCsPath)') and !$(_AnimationsCsText.Contains('AnimationFall = ResolveMagicAnimation(AnimationFall, &quot;fall&quot;, lowest);'))"
           Text="src/dotNet/Animations.cs no longer resolves the fall animation by fallback the way PetGraph.RuntimeFallbackFor mirrors it. Update PetGraph and PetGraphSelfTest with the host, deliberately." />
    <Error Condition="Exists('$(_AnimationsCsPath)') and !$(_AnimationsCsText.Contains('if (SheepAnimations.ContainsKey(current)) return current;'))"
           Text="Animations.ResolveMagicAnimation no longer keeps an exact binding first; PetGraph.Analyze roots the last exact match before any fallback and must follow the host." />
    <Error Condition="Exists('$(_AnimationsCsPath)') and !$(_AnimationsCsText.Contains('keys.Sort();'))"
           Text="Animations.ResolveMagicAnimation no longer walks the ids in ascending order; PetGraph.RuntimeFallbackFor sorts them and must follow the host." />
    <!-- Needles keep their parentheses BALANCED: MSBuild's condition parser matches parens through a quoted
         property-function argument, so a needle ending in `) return key;` was read as closing Contains() early. -->
    <Error Condition="Exists('$(_AnimationsCsPath)') and !$(_AnimationsCsText.Contains('name.IndexOf(word, StringComparison.OrdinalIgnoreCase)'))"
           Text="Animations.ResolveMagicAnimation no longer binds the first name CONTAINING the word ignoring case; PetGraph.RuntimeFallbackFor mirrors that test and must follow the host." />
    <Error Condition="Exists('$(_AnimationsCsPath)') and !$(_AnimationsCsText.Contains('return lowest;'))"
           Text="Animations.ResolveMagicAnimation no longer falls back to the lowest declared id; PetGraph.RuntimeFallbackFor mirrors that default and must follow the host." />
    <Error Condition="Exists('$(_AnimationsCsPath)') and $(_AnimationsCsText.Contains('AnimationKill = ResolveMagicAnimation'))"
           Text="src/dotNet/Animations.cs now resolves the KILL animation by fallback; PetGraph.FallbackResolvedNames lists fall and drag only and PetGraphSelfTest pins 'Kill' as an orphan. Change all three deliberately." />
    <Error Condition="Exists('$(_AnimationsCsPath)') and $(_AnimationsCsText.Contains('AnimationSync = ResolveMagicAnimation'))"
           Text="src/dotNet/Animations.cs now resolves the SYNC animation by fallback; PetGraph.FallbackResolvedNames lists fall and drag only and PetGraphSelfTest pins 'Sync' as an orphan. Change all three deliberately." />
  </Target>

</Project>
