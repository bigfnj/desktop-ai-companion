<Project Sdk="Microsoft.NET.Sdk">

  <!-- Remembrance module: records a meeting (a selectable microphone + the system output over WASAPI
       loopback), transcribes it offline with a local Whisper, names it from the calendar (via the Reminder
       module's "meeting.current" shared-context publish), snapshots the screen on a hotkey, and purges the
       audio + snapshots after 72 hours while keeping the transcript. References ONLY the plugin ABI
       (Private=false => the host's single shared DesktopAICompanion.Contracts) + ModuleKit (its own copy). WinForms
       is on for the UI-thread timer, a FolderBrowserDialog (storage location), and System.Drawing screen
       capture. NAudio (bundled, module load context) does the capture, the silent keep-alive stream beside the
       loopback source, and the offline mix at stop. -->
  <PropertyGroup>
    <!-- windows10.0.19041: NAudio.Wasapi (WASAPI loopback capture) ships only a net_-windows10.0.19041 asset,
         and WASAPI loopback needs Win10 anyway. The base stays on windows7.0 (DirectSound) because it never
         captures; this module does, so it targets the higher Windows API level. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopAICompanion.RemembranceModule</RootNamespace>
    <AssemblyName>Remembrance</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- CS0618: WasapiCapture / WasapiLoopbackCapture / WasapiOut are marked obsolete in favour of
         WasapiRecorder and WasapiPlayer. Those DO ship in the pinned NAudio 3.0.0-preview.6 (this comment said
         they did not, until 2026-09-29; RealtimeCaptureMixer is the one that does not). The classic classes
         stay because AudioRecorder's stop path is built on their threading, which is now understood and pinned
         by the module self-test; suppress the obsolete-usage warning deliberately. -->
    <NoWarn>$(NoWarn);618</NoWarn>
    <OutputPath>..\..\build\DesktopAICompanionPortable\bin\$(Configuration)\x64\modules\remembrance\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopAICompanion.Contracts\DesktopAICompanion.Contracts.csproj" Private="false" />
    <!-- ModuleKit ships inside the module folder (NOT Private=false) so each load context carries its own. -->
    <ProjectReference Include="..\..\src\DesktopAICompanion.ModuleKit\DesktopAICompanion.ModuleKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.0.0-preview.6" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.0-preview.6" />
  </ItemGroup>

  <!-- The coding-agent CLI runner (lane feature/cli-backend), shared with AI Brain: one source file both modules
       compile by link, with its self-check, plus AI Brain's executable trust rules (engine\AiExecutablePolicy.cs),
       which the runner applies to every candidate binary. Linked rather than copied, for the reason the summarizer
       gives for keeping its own HTTP client: a second copy of one policy drifts. -->
  <ItemGroup>
    <Compile Include="..\..\shared\CodingAgentCli\CodingAgentCli.cs" Link="cli\CodingAgentCli.cs" />
    <Compile Include="..\..\shared\CodingAgentCli\CodingAgentCliSelfCheck.cs" Link="cli\CodingAgentCliSelfCheck.cs" />
    <Compile Include="..\AiBrain\engine\AiExecutablePolicy.cs" Link="cli\AiExecutablePolicy.cs" />
  </ItemGroup>

  <!-- The cloud summary's transport (2.2.0, CloudSummary.cs): AI Brain's endpoint policy, which refuses plain http to
       another computer, follows no redirect, bounds every read and wait and keeps a provider's error text for the pane,
       and the lenient JSON reader it uses. Linked for the runner's reason: one policy for every endpoint that can receive
       a key or text off this machine, so a second copy cannot drift from the first. -->
  <ItemGroup>
    <Compile Include="..\AiBrain\engine\AiEndpointPolicy.cs" Link="cloud\AiEndpointPolicy.cs" />
    <Compile Include="..\AiBrain\engine\JsonRead.cs" Link="cloud\JsonRead.cs" />
  </ItemGroup>

  <!-- Tray icons, read at Init via EmbeddedResources.LoadBytes (matches on the trailing file name). Every
       tray entry this module contributes has its own, which is a project convention. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\recording.png" />
    <EmbeddedResource Include="Resources\snapshot.png" />
  </ItemGroup>

</Project>
