<Project Sdk="Microsoft.NET.Sdk">

  <!-- The AI-brain module (S4): the optional screen-commentary LLM, extracted from the base into a plugin.
       Builds to the runtime modules\aibrain\ folder so the loader picks it up. References ONLY the plugin
       ABI (Private=false => the host's single shared DesktopAICompanion.Contracts is used).

       S4a-2 is the DORMANT scaffold: Init does nothing behavioral, so the base keeps owning the AI brain at
       runtime (no double-ask / double-hotkey) until the flip (S4b) = zero regression. The engine (AiBrain +
       backends + Dispositions + module settings) relocates here in S4a-3 and turns on
       UseWindowsForms for the screen-capture path. The engine's JSON is System.Text.Json (in-box on net10),
       so the module carries no third-party JSON package — it is Newtonsoft-free like the rest of the product. -->
  <PropertyGroup>
    <!-- The 10.0.19041 flavour projects the Windows runtime APIs, which is what gives us Windows'
         BUILT-IN OCR (Windows.Media.Ocr) as a zero-install fallback when Tesseract isn't present.
         It costs ~6 MB compressed in this module's package (a ~24 MB metadata-heavy projection DLL
         that compresses ~4x) and NOTHING in the base — the projection travels with the module, and a
         spike confirmed it resolves inside the module's own collectible AssemblyLoadContext.
         Caveat: a WinRT-using module pins its load context, so its ALC never unloads. Harmless here —
         module uninstall already requires a process restart (see PendingModuleRemovals). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- The relocated engine captures the screen (System.Drawing + System.Windows.Forms.Screen) and reads
         OCR/vision, so the module needs WinForms + System.Drawing (in-box on net10-windows). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopAICompanion.AiBrainModule</RootNamespace>
    <AssemblyName>AiBrain</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The module still owns non-ABI deps that a library project won't copy to output by default (e.g. the
         module's transitive assemblies resolved through its own AssemblyLoadContext), so keep
         CopyLocalLockFileAssemblies + GenerateDependencyFile even though the JSON layer is now in-box STJ. -->
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>..\..\build\DesktopAICompanionPortable\bin\$(Configuration)\x64\modules\aibrain\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopAICompanion.Contracts\DesktopAICompanion.Contracts.csproj" Private="false" />
    <!-- ModuleKit is deliberately NOT Private="false" like the contract: the host shares one contract, but
         the support library ships inside this module's folder so each load context carries its own copy. -->
    <ProjectReference Include="..\..\src\DesktopAICompanion.ModuleKit\DesktopAICompanion.ModuleKit.csproj" />
  </ItemGroup>

  <!-- Tray-item icons (TrayItem.IconPng): the ABI carries raw PNG bytes, not a concrete image type, so these
       stay plain embedded resources read via GetManifestResourceStream, same pattern as Fortunes' welcome.json. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\ai-brain.png" />
    <EmbeddedResource Include="Resources\monitor.png" />
  </ItemGroup>

</Project>
