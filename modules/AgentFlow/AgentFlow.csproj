<Project Sdk="Microsoft.NET.Sdk">

  <!-- A DesktopAICompanion plugin module (see templates\desktop-ai-companion-module). The load-bearing bits:
       OutputPath must end in modules\<id>\ because the host scans <app>\modules and loads <id>\<id>.dll;
       Contracts is Private="false" so the module binds the HOST's single shared copy (ship a second and
       the IModule cast fails at load); AppendTargetFrameworkToOutputPath=false keeps the dll where the
       loader looks. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopAICompanion.AgentFlow</RootNamespace>
    <AssemblyName>AgentFlow</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\build\DesktopAICompanionPortable\bin\$(Configuration)\x64\modules\agentflow\</OutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- WinForms for the poll timer only. Its Tick lands on the UI thread the host loaded the module
         on, which is what the IHost contract requires of every service call. No window: the host
         renders the tray item and the options pane from the data this module declares. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopAICompanion.Contracts\DesktopAICompanion.Contracts.csproj" Private="false" />
    <ProjectReference Include="..\..\src\DesktopAICompanion.ModuleKit\DesktopAICompanion.ModuleKit.csproj" />
  </ItemGroup>

  <!-- Tray icon, read at Init via EmbeddedResources.LoadBytes (matches on the trailing file name). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\agentflow.png" />
    <!-- Tray icon for the module's own entry. Downscaled to 32x32 from the 640x640 original at
         https://aiexplained.app/brand-mascot.png, fetched 2026-09-18 at the maintainer's request;
         1.4 KB embedded rather than 155 KB, because this is only ever drawn at menu size. -->
    <EmbeddedResource Include="Resources\brand-mascot.png" />
  </ItemGroup>

</Project>
