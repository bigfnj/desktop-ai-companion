<Project Sdk="Microsoft.NET.Sdk">

  <!-- A DesktopAICompanion plugin module (see templates\desktop-ai-companion-module). The load-bearing bits:
       OutputPath must end in modules\<id>\ because the host scans <app>\modules and loads <id>\<id>.dll;
       Contracts is Private="false" so the module binds the HOST's single shared copy (ship a second and
       the IModule cast fails at load); AppendTargetFrameworkToOutputPath=false keeps the dll where the
       loader looks. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopAICompanion.AgentFlow</RootNamespace>
    <AssemblyName>AgentFlow</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\build\DesktopAICompanionPortable\bin\$(Configuration)\x64\modules\agentflow\</OutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- WinForms for the poll timer only. Its Tick lands on the UI thread the host loaded the module
         on, which is what the IHost contract requires of every service call. No window: the host
         renders the tray item and the options pane from the data this module declares. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DesktopAICompanion.Contracts\DesktopAICompanion.Contracts.csproj" Private="false" />
    <ProjectReference Include="..\..\src\DesktopAICompanion.ModuleKit\DesktopAICompanion.ModuleKit.csproj" />
  </ItemGroup>

  <!-- Tray icon, read at Init via EmbeddedResources.LoadBytes (matches on the trailing file name). -->
  <ItemGroup>
    <!-- The orb, isolated from docs/images/agentflow-icon.jpg and masked to its circle: the source
         is a 2384x1792 JPEG of the orb sitting on a rendered transparency checkerboard, so the
         background is real grey pixels rather than alpha and had to be cut away.

         Found by SATURATION, not by eye. The checkerboard is strictly achromatic and the orb is
         not, so thresholding the saturation channel gives its bounding box exactly: 938x941, which
         being square is itself the check that the thing found is the circle.

         The mask radius is 465 and not the 470 that box implies. At 470 a thin ring of the dark
         checkerboard tile survived all the way round: invisible at 32x32, obvious when composited
         over magenta and magnified, which is the only reason it was caught. -->
    <EmbeddedResource Include="Resources\agentflow-orb.png" />
  </ItemGroup>

</Project>
