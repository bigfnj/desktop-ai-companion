<Project Sdk="Microsoft.NET.Sdk">

  <!-- The module author's support library: the helpers every module was copying by hand.

       This is NOT part of the ABI. DesktopAICompanion.Contracts is the contract between the host and a module and
       must stay tiny and frozen; ModuleKit is ordinary convenience code that a module CHOOSES to reference,
       and it ships INSIDE the module's own folder. Each module loads in its own collectible
       AssemblyLoadContext, so every module gets its own copy of this DLL and two modules can safely use
       different ModuleKit versions — which is exactly why the helpers belong here rather than in the
       contract, where a change would be permanent and global.

       The reference to DesktopAICompanion.Contracts is Private="false" for the same reason a module's is: the host
       owns the single shared copy, and the loader resolves that assembly from the default context so the
       IHost/IModule types unify across the host and every module.

       Lives under src/ so it inherits Directory.Build.props (LangVersion 7.3, deterministic,
       warnings-as-errors). Keep it dependency-free: System.Text.Json and the DPAPI/ACL types are in-box on
       net10-windows, and adding an out-of-band PackageReference for one would trip NU1510 as an error. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopAICompanion.ModuleKit</RootNamespace>
    <AssemblyName>DesktopAICompanion.ModuleKit</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Unlike the contract's frozen 1.0.0.0 binding identity, ModuleKit is a normal library: it is copied
         per module rather than shared, so its version can move without invalidating anything already built. -->
    <Version>$(DesktopAICompanionVersion)</Version>
    <FileVersion>$(DesktopAICompanionAssemblyVersion)</FileVersion>
    <Company>bigfnj</Company>
    <Product>Desktop AI Companion</Product>
  </PropertyGroup>

  <!-- Published to NuGet alongside the contract, so an out-of-repo author gets the same helpers the
       first-party modules use. Unlike the contract this is optional: a module can ignore it entirely. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DesktopAICompanion.ModuleKit</PackageId>
    <Title>DesktopAICompanion module support library</Title>
    <Description>Helpers for writing a DesktopAICompanion module: durable file writes, cross-session locking, embedded-resource loading, per-module paths, a JSON settings store, and a Testing namespace with a headless RecordingHost so a module can be self-tested with no app running. Optional; DesktopAICompanion.Contracts is the only required reference.</Description>
    <Authors>bigfnj</Authors>
    <PackageTags>desktoppet;plugin;module;desktop-pet</PackageTags>
    <PackageProjectUrl>$(DesktopAICompanionRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(DesktopAICompanionRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Symbols live INSIDE the dll, and there is no .snupkg. See the matching comment in
      DesktopAICompanion.Contracts.csproj for the full reasoning; the short version is that
      release.yml discards every '*.snupkg', so the separate symbol package was built and never
      delivered. The separate PDB's CodeView record is no reason to embed (N-bd-w13-review-01): it
      named an absolute build path only while unmapped, and PathMap alone rewrites it. Measured on
      SDK 10.0.302, a separate-PDB build with the PathMap below names
      /_/src/DesktopAICompanion.ModuleKit/obj/.../DesktopAICompanion.ModuleKit.pdb in that record.
      Embedding costs about 14 KB on the dll (61,952 bytes against 47,616 for the separate-PDB
      build, measured 2026-11-12).

      A build path in these symbols matters more here than for Contracts: ModuleKit is copied into
      every modules-dist\*.zip and Contracts into none, so a path in its symbols ships in every
      published module payload rather than only in the release.

      Do not re-add IncludeSymbols alongside this. Measured on SDK 10.0.302 with the pair this project
      set before embedding, IncludeSymbols and SymbolPackageFormat=snupkg (passed on the command line,
      since nothing in the repo sets either now), `dotnet pack` here does not fail NU5017 as Contracts
      does: the symbol package's nuspec repeats the dependency on DesktopAICompanion.Contracts, which
      satisfies NuGet's no-dependencies-nor-content check, so pack succeeds and writes a .snupkg
      holding no symbols at all, which release.yml would then discard. With IncludeSymbols alone the
      symbol package takes NuGet's default format, and what pack writes then was not measured.

      What embedding did NOT remove (RA-208, 2026-10-01): the document table INSIDE the embedded PDB
      named every source file by the maintainer's absolute path, fifteen D:\...\src\...\*.cs strings in
      each modules-dist zip, sitting in a compressed blob no byte-scan of the DLL could see. PathMap
      rewrites the project directory to the /_/ root a CI build's DeterministicSourcePaths would use,
      so a release built here and one built in CI carry the same document names and neither names a
      machine. CoreTests reads the table back ("ModuleKit shipped symbols") and fails on a drive-rooted
      document, which is the check that makes this line load-bearing rather than decorative.
    -->
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/DesktopAICompanion.ModuleKit</PathMap>
    <!-- Source Link OFF (N-bd-w12-converter-1-01); the trade-off and the alternative not taken are beside the same
         line in DesktopAICompanion.Contracts.csproj. Here it is the record that reached users: the SDK's default
         Source Link record maps the absolute checkout folder, outside PathMap's reach, and this dll ships in every
         modules-dist zip. CoreTests ("ModuleKit shipped symbols") fails on any Source Link record. -->
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopAICompanion.Contracts\DesktopAICompanion.Contracts.csproj" Private="false" />
  </ItemGroup>

</Project>
