<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET 10 (LTS) WinForms, framework-dependent, x64-only (ONNX native runtime is arch-specific and
       build.ps1 always builds x64). Converted from the classic net48 project; product identity/version
       still come from ProductVersion.props via the WriteCodeFragment targets below (GenerateAssemblyInfo
       stays off so there is one source of truth). Compile/EmbeddedResource/None/Content are listed
       explicitly (EnableDefaultItems=false) so src\legacy and Tools are never pulled in by globbing. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF is enabled alongside WinForms (both in-box on net10-windows) for the S5 module-manager /
         options window; the pet itself stays WinForms. The WPF window is shown from the WinForms UI thread. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>DesktopAICompanion</RootNamespace>
    <AssemblyName>DesktopAICompanion</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- x64-only, framework-dependent. Pinning the RID (SelfContained=false keeps it FDD, no bundled
         runtime) flattens package native assets — e.g. onnxruntime.dll — into the
         output root instead of a runtimes\win-x64\native subfolder, which the flat leaf-name payload
         manifest (runtime-files.txt) + ZIP + WiX generator require. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <SignAssembly>false</SignAssembly>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == '' and '$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Keep the flat bin\<Config>\x64 layout build.ps1 + packaging expect (no TFM/RID subfolder). -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- WFDEV006: the dev-only debug right-click menu still uses the legacy ContextMenu/MenuItem
         (kept for behavior parity during the migration; modernize to ContextMenuStrip later). -->
    <NoWarn>$(NoWarn);WFDEV006</NoWarn>
  </PropertyGroup>

  <!-- Conditioned on Configuration ALONE, deliberately. These groups used to also test $(Platform), which
       meant a plain `dotnet build` (no -p:Platform=x64) silently lost DefineConstants: without PORTABLE the
       #if PORTABLE block in Program.cs drops out and the build fails with ~20 unrelated-looking CS errors.
       The platform dimension carried no information anyway (Platforms, PlatformTarget and RuntimeIdentifier
       are all pinned to x64 unconditionally above), so dropping it lets a cold clone build the way CI does. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>..\build\DesktopAICompanionPortable\bin\Debug\x64\</OutputPath>
    <IntermediateOutputPath>..\build\DesktopAICompanion\obj\Debug\x64\</IntermediateOutputPath>
    <DefineConstants>TRACE;DEBUG;PORTABLE</DefineConstants>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\build\DesktopAICompanionPortable\bin\Release\x64\</OutputPath>
    <IntermediateOutputPath>..\build\DesktopAICompanion\obj\Release\x64\</IntermediateOutputPath>
    <DefineConstants>TRACE;PORTABLE</DefineConstants>
    <Optimize>true</Optimize>
    <!-- Release symbols are not distributed; no PDB keeps the runtime location-independent. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Runtime NuGet dependencies. The net48 in-box shims (System.Buffers/Memory/ValueTuple/
       Threading.Tasks.Extensions/Numerics.Vectors/Runtime.CompilerServices.Unsafe/Security.*/
       Win32.Registry/Bcl.AsyncInterfaces/IO.Pipelines/Text.Json/Text.Encodings.Web) and the net48
       compiler + reference-assembly packages are dropped: they are provided by the .NET 10 shared
       framework / Windows Desktop framework. System.Drawing.Common, System.Configuration.Configuration-
       Manager, and System.Security.Cryptography.ProtectedData (DPAPI) are all provided by the
       net10-windows Windows Desktop framework too (the SDK prunes them; NU1510 confirms). Only these
       genuinely-external packages remain. -->
  <!-- DesktopAICompanion.exe apphost + DesktopAICompanion.dll are framework-dependent (require the .NET 10 Desktop runtime). -->
  <ItemGroup>
    <!-- ONNX moved to the Fortunes module (S3d): the smart fortune engine (Embedder/SmartFortunes) +
         onnxruntime + the bge-small model now live in modules/Fortunes. The base no longer references ONNX. -->

    <!-- NAudio is a base dependency again as of B1 (host-owned audio output, AudioOutput.cs). It left in S2
         on the premise that no pet shipped audio; every bundled pet does. Sub-packages we use: NAudio.Core
         (Mp3FileReaderBase + the mixer), NAudio.WinMM (ACM MP3 decode via the OS codec), and NAudio.Dmo
         (DirectSoundOut = the device-selectable output, B1.5). No Asio/Wasapi/WinForms, and no shipped
         native binary. WASAPI was rejected: its package needs a Win10-versioned TFM that drags a ~25 MB
         Windows SDK projection into the payload. NAudio 3 preview (net9+, Span-based) since the base is
         net10; verified decoding a real pet MP3 + enumerating devices on net10. -->
    <PackageReference Include="NAudio.Core" Version="3.0.0-preview.6" />
    <PackageReference Include="NAudio.WinMM" Version="3.0.0-preview.6" />
    <PackageReference Include="NAudio.Dmo" Version="3.0.0-preview.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin ABI. Ships beside the exe so module DLLs bind to the same DesktopAICompanion.Contracts. -->
    <ProjectReference Include="DesktopAICompanion.Contracts\DesktopAICompanion.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
