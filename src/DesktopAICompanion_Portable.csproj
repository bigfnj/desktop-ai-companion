    <Compile Include="dotNet\AnimationReachability.cs" />
    <Compile Include="dotNet\AudioOutput.cs" />
    <Compile Include="dotNet\ContextMenus.cs" />
    <Compile Include="dotNet\AppLifetime.cs" />
    <Compile Include="dotNet\TrayPromotion.cs" />
    <Compile Include="dotNet\FactoryReset.cs" />
    <Compile Include="dotNet\CompanionCatalog.cs" />
    <Compile Include="dotNet\AppUpdateCheck.cs" />
    <Compile Include="dotNet\CompanionFreshness.cs" />
    <Compile Include="dotNet\CompanionTypeRegistry.cs" />
    <Compile Include="dotNet\StartupRegistration.cs" />
    <Compile Include="Portable\Options\OptionsController.cs" />
    <Compile Include="Portable\Wpf\OptionsWindow.cs" />
    <Compile Include="Portable\Wpf\OptionsShell.cs" />
    <Compile Include="Portable\Wpf\WpfTheme.cs" />
    <Compile Include="Portable\Wpf\AboutWindow.cs" />
    <Compile Include="Portable\Wpf\CompanionsPaneControl.cs" />
    <Compile Include="Portable\Wpf\ModulesPaneControl.cs" />
    <Compile Include="Portable\Wpf\CompanionBlurbs.cs" />
    <Compile Include="dotNet\ProcessIcon.cs" />
    <Compile Include="LocalData\AnimationXML.cs" />
    <Compile Include="Portable\WebLinks.cs" />
    <Compile Include="Portable\AppPaths.cs" />
    <Compile Include="Portable\AppSettingsStore.cs" />
    <Compile Include="Portable\JsonRead.cs" />
    <Compile Include="Portable\LocalData.cs" />
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="dotNet\StartUp.cs" />
    <Compile Include="dotNet\RuntimeGeometry.cs" />
    <Compile Include="dotNet\SpriteBounds.cs" />
    <Compile Include="dotNet\FullscreenScan.cs" />
    <Compile Include="dotNet\WindowTheme.cs" />
    <Compile Include="dotNet\FormSpeech.cs" />
    <Compile Include="dotNet\Ai\ActiveWindow.cs" />
    <Compile Include="dotNet\Ai\FortunePackLoadPolicy.cs" />
    <!-- The base fortune engine (FortuneProvider.cs + FortuneFileImporter.cs) moved to modules/Fortunes;
         only FortunePackLoadPolicy remains here, consumed by RemoteCatalog for catalog pack bounds. -->
    <Compile Include="dotNet\Ai\PokeReactions.cs" />
    <Compile Include="dotNet\Ai\HotkeyListener.cs" />
    <Compile Include="dotNet\SecureDownload.cs" />
    <Compile Include="dotNet\RemoteCatalog.cs" />
    <Compile Include="dotNet\SafeExpression.cs" />
    <Compile Include="dotNet\CompanionXmlValidator.cs" />
    <Compile Include="dotNet\AudioOutputSelfTest.cs" />
    <Compile Include="dotNet\SecuritySelfTest.cs" />
    <Compile Include="dotNet\FormCompanion.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="dotNet\FormCompanion.Designer.cs">
      <DependentUpon>FormCompanion.cs</DependentUpon>
    </Compile>
    <Compile Include="dotNet\FormDebug.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="dotNet\FormDebug.Designer.cs">
      <DependentUpon>FormDebug.cs</DependentUpon>
    </Compile>
    <Compile Include="dotNet\Program.cs" />
    <Compile Include="Properties\AssemblyInfoPortable.cs" />
    <Compile Include="Properties\Settings1.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Include="Settings.cs" />
    <Compile Include="Tools\XmlToDot.cs" />
    <Compile Include="dotNet\Xml.cs" />
    <Compile Include="dotNet\CompanionThumbnails.cs" />
    <Compile Include="dotNet\RuntimeHardeningSelfTest.cs" />
    <Compile Include="dotNet\WpfOptionsSelfTest.cs" />
    <Compile Include="dotNet\Plugins\ModuleHost.cs" />
    <Compile Include="dotNet\Plugins\ModuleHostRequirement.cs" />
    <Compile Include="dotNet\Plugins\ModuleUpdateScan.cs" />
    <Compile Include="dotNet\Plugins\PendingModuleRemovals.cs" />
    <Compile Include="dotNet\Plugins\PendingModuleUpdates.cs" />
    <Compile Include="dotNet\Plugins\ModuleConventionSelfTest.cs" />
    <Compile Include="dotNet\Plugins\SelfTestScratch.cs" />
    <Compile Include="dotNet\Plugins\ModuleHostSelfTest.cs" />
    <Compile Include="dotNet\Plugins\CompanionHost.cs" />
    <Compile Include="dotNet\Plugins\FortunesModuleSelfTest.cs" />
    <Compile Include="dotNet\Plugins\FortunesEngineSelfTest.cs" />
    <Compile Include="dotNet\Plugins\AiBrainModuleSelfTest.cs" />
    <Compile Include="dotNet\Plugins\PetStudioModuleSelfTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="dotNet\FormCompanion.resx">
      <DependentUpon>FormCompanion.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="dotNet\FormDebug.resx">
      <DependentUpon>FormDebug.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <SubType>Designer</SubType>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <!-- fortunes.txt + the classifier-parity TSV moved to modules/Fortunes with the fortune engine;
         the base no longer embeds or reads them. -->
    <EmbeddedResource Include="Resources\pet-thumbnails.zip" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\app.manifest">
      <SubType>Designer</SubType>
    </None>
    <None Include="Properties\Settings.settings">
      <SubType>Designer</SubType>
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings1.Designer.cs</LastGenOutput>
    </None>
    <None Include="Resources\animations.xsd">
      <SubType>Designer</SubType>
    </None>
    <None Include="Resources\animations.xml">
      <SubType>Designer</SubType>
    </None>
    <None Include="Images\install.png" />
    <None Include="Images\option.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="esheep.png.ico" />
    <Content Include="icon.ico" />
    <Content Include="Images\exit.png" />
    <Content Include="Images\help.png" />
    <Content Include="Images\about.png" />
    <Content Include="Images\esheep.png" />
    <!-- The bge-small smart-fortunes model moved to the Fortunes module (S3d), beside Fortunes.dll. -->
    <Content Include="..\LICENSE">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\THIRD_PARTY_NOTICES.md">
      <Link>THIRD_PARTY_NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\PRIVACY.md">
      <Link>PRIVACY.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\SUPPORT.md">
      <Link>SUPPORT.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\PROVENANCE.md">
      <Link>PROVENANCE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- NAudio is a base dependency again as of B1 (host-owned audio); ship its license in the base root.
         The Sound module still carries its own copy until B4 retires it. -->
    <Content Include="..\packaging\licenses\NAUDIO_LICENSE.txt"
             Condition="Exists('..\packaging\licenses\NAUDIO_LICENSE.txt')">
      <Link>NAUDIO_LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- ONNX runtime licenses now ship with the Fortunes module (they moved with the engine, S3d).
         Newtonsoft.Json was dropped in favor of the in-box System.Text.Json (post-S5c cleanup), so no
         Newtonsoft license ships in the base any more. -->
  </ItemGroup>

  <Target Name="ValidateDesktopAICompanionProductIdentity" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DesktopAICompanionProductName)' == '' or '$(DesktopAICompanionPublisher)' == '' or '$(DesktopAICompanionVersion)' == '' or '$(DesktopAICompanionAssemblyVersion)' == ''"
           Text="ProductVersion.props is missing or incomplete. Product identity and version metadata cannot be generated." />
  </Target>
  <Target Name="GenerateDesktopAICompanionProductInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_DesktopAICompanionProductInfoFile>$(IntermediateOutputPath)DesktopAICompanion.ProductInfo.g.cs</_DesktopAICompanionProductInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_DesktopAICompanionAssemblyAttribute Include="System.Reflection.AssemblyTitleAttribute">
        <_Parameter1>$(DesktopAICompanionProductName)</_Parameter1>
      </_DesktopAICompanionAssemblyAttribute>
      <_DesktopAICompanionAssemblyAttribute Include="System.Reflection.AssemblyDescriptionAttribute">
        <_Parameter1>$(DesktopAICompanionDescription)</_Parameter1>
      </_DesktopAICompanionAssemblyAttribute>
      <_DesktopAICompanionAssemblyAttribute Include="System.Reflection.AssemblyCompanyAttribute">
        <_Parameter1>$(DesktopAICompanionPublisher)</_Parameter1>
      </_DesktopAICompanionAssemblyAttribute>
      <_DesktopAICompanionAssemblyAttribute Include="System.Reflection.AssemblyProductAttribute">
        <_Parameter1>$(DesktopAICompanionProductName)</_Parameter1>
      </_DesktopAICompanionAssemblyAttribute>
      <_DesktopAICompanionAssemblyAttribute Include="System.Reflection.AssemblyCopyrightAttribute">
        <_Parameter1>$(DesktopAICompanionCopyright)</_Parameter1>
      </_DesktopAICompanionAssemblyAttribute>
      <_DesktopAICompanionAssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(DesktopAICompanionAssemblyVersion)</_Parameter1>
      </_DesktopAICompanionAssemblyAttribute>
      <_DesktopAICompanionAssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(DesktopAICompanionAssemblyVersion)</_Parameter1>
      </_DesktopAICompanionAssemblyAttribute>
      <_DesktopAICompanionAssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(DesktopAICompanionVersion)</_Parameter1>
      </_DesktopAICompanionAssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#"
                       OutputFile="$(_DesktopAICompanionProductInfoFile)"
                       AssemblyAttributes="@(_DesktopAICompanionAssemblyAttribute)" />
    <ItemGroup>
      <Compile Include="$(_DesktopAICompanionProductInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
