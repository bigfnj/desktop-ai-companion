<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\ProductVersion.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\ProductVersion.props')" />
  <!--
    Shared MSBuild properties for every project under src/.

    THE product is the portable app: DesktopAICompanion_Portable.csproj -> DesktopAICompanion.exe
    (built via ..\build.ps1, opened via DesktopAICompanion_Portable.sln). All the AI-Edition
    work lives there. (The former src/legacy quarantine and the Tools/ tree are gone; the repo
    builds exactly one product.)

    The C# source targets language level 7.3 (old-style csproj default). Pin it here
    so the level is explicit and consistent instead of relying on the toolchain default.
  -->
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
