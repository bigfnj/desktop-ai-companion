<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\ProductVersion.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\ProductVersion.props')" />
  <!--
    Shared MSBuild properties for every project under src/.

    THE product is the portable app: DesktopAICompanion_Portable.csproj -> DesktopAICompanion.exe
    (built via ..\build.ps1, opened via DesktopAICompanion_Portable.sln). All the AI-Edition
    work lives there. (The former src/legacy quarantine and the Tools/ tree are gone; the repo
    builds exactly one product.)

    The C# source targets language level 7.3 (old-style csproj default). Pin it here
    so the level is explicit and consistent instead of relying on the toolchain default.
  -->
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      No WarningLevel here, on purpose (N-audit-1106-136). For a .NETCoreApp target the SDK sets it
      to the target framework's major version (Microsoft.NET.Sdk.Analyzers.targets), so net10.0 builds
      at 10 and the compiler's warning waves 5 to 10 are on. This file used to pin 4, the .NET
      Framework value, which switched every wave off for all four projects here, so the setting below
      could never turn one of those warnings into an error. Measured 2026-11-07 before removing it:
      the host, Contracts, ModuleKit and AgentBroker.Core rebuilt at level 10 with 0 warnings, and a
      LangVersion 7.3 scratch project raised CS8981 (wave 7) at the SDK default and not at 4.
      tests/runtime-hardening-selftest.ps1 refuses a pin below 10 in this file or a src project.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
