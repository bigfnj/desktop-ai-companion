<Project Sdk="Microsoft.NET.Sdk">

  <!-- The stable, versioned plugin ABI. Third-party module DLLs reference ONLY this small assembly,
       never the app. Keep it minimal and dependency-free (no WinForms/WPF/System.Drawing leakage) so
       the contract can evolve independently of the host. Its AssemblyVersion IS the ABI version that
       modules declare a MinHostVersion against. Lives under src/ so it inherits Directory.Build.props
       (LangVersion 7.3, Deterministic, warnings-as-errors). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopAICompanion.Modules</RootNamespace>
    <AssemblyName>DesktopAICompanion.Contracts</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- AssemblyVersion is the ABI binding version modules reference ("DesktopAICompanion.Contracts, Version=
         1.0.0.0"); it MUST stay stable or already-built modules fail to load. FileVersion, by contrast,
         tracks the PRODUCT (from ProductVersion.props via src/Directory.Build.props) so a Windows Installer
         major upgrade actually refreshes this DLL when the ABI changes — a fixed FileVersion made the
         installer skip the overwrite, shipping a stale Contracts.dll that couldn't resolve new ABI types. -->
    <Version>$(DesktopAICompanionVersion)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(DesktopAICompanionAssemblyVersion)</FileVersion>
    <Company>bigfnj</Company>
    <Product>Desktop AI Companion</Product>
  </PropertyGroup>

  <!-- Published to NuGet so a module can be built OUTSIDE this repo. This assembly is already the right
       shape for it: no dependencies, and an AssemblyVersion frozen at 1.0.0.0 so a module built against any
       package version keeps binding to the copy the host ships. The PACKAGE version tracks the product, which
       is the useful signal for an author — it names the host release the contract came from, and it is what a
       module's MinHostVersion is compared against at load time. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>DesktopAICompanion.Contracts</PackageId>
    <Title>DesktopAICompanion plugin contract</Title>
    <Description>The plugin ABI for Desktop AI Companion: implement IModule, talk to the app through IHost. Reference this and nothing else to build a module. See docs/module-authoring.md in the repository.</Description>
    <Authors>bigfnj</Authors>
    <PackageTags>desktoppet;plugin;module;desktop-pet</PackageTags>
    <PackageProjectUrl>$(DesktopAICompanionRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(DesktopAICompanionRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Symbols live INSIDE the dll, and there is no .snupkg.

      Two reasons were given, and only the first holds. First, the separate symbol package was
      never delivered to anybody: release.yml filters '*.snupkg' out of both SHA256SUMS.txt and the
      release assets, so IncludeSymbols + SymbolPackageFormat=snupkg produced a file every release
      built and then discarded. Embedding means a module author debugging into the ABI actually HAS
      symbols, which until now they never did.

      Second, it was said that a separate PDB leaves the maintainer's absolute build path in the shipped
      assembly's CodeView record (D:\...\obj\Release\...\DesktopAICompanion.Contracts.pdb) and that
      PathMap cannot fix that. The first half was true of the unmapped PDB this project had then, and this
      assembly ships beside the exe in both the portable ZIP and the MSI. The second half is wrong: PathMap
      DOES rewrite the PDB path in the CodeView record. Measured on SDK 10.0.302, a separate-PDB build with
      the PathMap below names /_/src/DesktopAICompanion.Contracts/obj/.../DesktopAICompanion.Contracts.pdb,
      and the same build with PathMap emptied names the absolute obj path. Embedded, the record holds the
      bare file name. So that path is not a reason to embed; the map alone would have cured it.

      With the PDB embedded, the paths INSIDE it are the leak that remains. PathMap fixes the document
      table's (RA-208, 2026-10-01): the project directory is rewritten to the /_/ root a CI build's
      DeterministicSourcePaths would use, so the document table names /_/src/... on every machine.
      CoreTests reads it back ("ModuleKit shipped symbols", both this assembly and ModuleKit) and fails
      on a drive-rooted document.

      Do not re-add IncludeSymbols alongside this: `dotnet pack` then fails NU5017 ("cannot create a
      package that has no dependencies nor content") because the symbol package has nothing left to
      carry. If separate symbol packages are ever wanted, publish them as release assets first, or the
      setting is once again producing an artifact nobody receives.
    -->
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/DesktopAICompanion.Contracts</PathMap>
    <!-- Source Link OFF (N-bd-w12-converter-1-01), the choice tools\ShimejiConvert.Engine made (N-bd-closure2-02).
         The SDK adds it by default, and its record inside the embedded PDB maps the checkout folder, by absolute
         path and outside PathMap's reach, to a raw URL carrying the commit, so every workstation build named the
         folder it was built in; ModuleKit's copy in every modules-dist zip did. A CI build maps that folder to /_/
         and its record is clean (measured with CI=true: one /_/* key), so what OFF costs is automatic source fetch
         for an author stepping into this assembly from a published package, which release.yml packs in CI; the
         document names stay the repository-relative /_/src/....
         The alternative is Source Link ON with DeterministicSourcePaths on every build, which keeps that fetch and
         gives a workstation build the same clean record (measured). It is not refused for the converter's reason
         (N-bd-w13-review-01). The converter's dll carries no version stamp (GenerateAssemblyInfo false), so there
         the commit in the record's URL would have made two commits with identical code build different bytes. This
         library and ModuleKit already carry the full commit in AssemblyInformationalVersion and again in the
         version resource's ProductVersion (the version, a plus sign and the commit, read back from Release builds
         on SDK 10.0.302), so they differ per commit with Source Link on or off. What the alternative runs into is
         two checks, each failing on ANY Source Link record, mapped or not: CoreTests ("ModuleKit shipped symbols")
         reads this dll and ModuleKit's, and the build-identity scan in packaging/Test-ModulePublishFreshness.ps1
         (N-bd-w13-contracts-1-02) reads the ModuleKit.dll in every modules-dist zip, none of which carries this
         dll. So a mapped record would still be refused. Taking it means relaxing both to accept a record whose
         only key is /_/*, and until that is decided this line stays OFF. -->
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
