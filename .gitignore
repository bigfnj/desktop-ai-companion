# Local agent/session control files. These are per-developer working state -- instructions, tool
# permissions, MCP server definitions, scratch memory -- and none of it belongs to the product.
# MCP/permission files in particular can carry endpoints and tokens, so they are fail-closed here
# rather than relied on to be tidied up by hand.
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/
.codex/
.cursor/
.cursorrules
.windsurfrules
.aider*
.mcp.json
SESSION_*
HANDOFF_*

# Secrets. Nothing of the sort is tracked today and the app keeps real keys DPAPI-encrypted under
# %LOCALAPPDATA%\DesktopPet, well outside this tree -- these patterns exist so a stray local file
# cannot become a commit.
.env
.env.*
*.pem
*.p12
*.jks
secrets.json
appsettings.*.local.json

# Portable app runtime settings store
DesktopPet.config

# Generated fortune-labeling work. These exact paths are also fail-closed in
# packaging/Invoke-ReleaseGate.ps1 and must never enter a source or release artifact.
/src/Fortunes/label-input.tsv
/src/Fortunes/labels-store.tsv
/src/Fortunes/label-chunks/
/src/Fortunes/.texts
/src/Fortunes/.batchtexts
/src/Fortunes/label-batch.txt

# Local dev/test materials kept under tests/ (screen recordings, audio, sample skins) -- never shipped.
tests/*.mp4
tests/*.mp3
tests/*.zip
tests/*-transcription.md
